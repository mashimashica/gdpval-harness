set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./gdpval [compare-runs] [options]

Run this repository's GDPval recipe from the repository root.

Commands:
  compare-runs          Blind-compare two existing GDPval deliverable directories

Options:
  --limit N             Run only N tasks (for example: --limit 1)
  --out DIR             Output directory (default: ./results/gdpval)
  --parallel N          Evaluator and agent concurrency
  --provider NAME       Apply a policy-provider preset (openai, gemini, openrouter, litellm, vllm, generic)
  --model-type TYPE     Gym response model type (default: vllm_model)
  --model MODEL         Override the policy model ID from env.yaml
  --base-url URL        Override the policy model base URL from env.yaml
  --judge-panel MODE    Judge mode: aa-v2 (default) or single
  --judge-model MODEL   Model ID for single-judge mode
  --judge-base-url URL  Override the judge gateway base URL
  --judge-seed N        Seed deterministic judge sampling
  --judge-only          Re-score existing deliverables without running the agent
  --rubric              Score against GDPval rubrics (default)
  --comparison DIR      Compare against rated reference deliverables in DIR
  --reference-manifest FILE
                        Reference model names and Elo anchors for comparison mode
  --aa-v2 DIR           GDPval-AA v2 profile using the pinned reference manifest
  --resume              Resume an interrupted run
  --pin-gym             Opt in to NVIDIA's pinned Gym revision reproduction
  --check               Validate local prerequisites and exit without running GDPval
  --a DIR               compare-runs: candidate A deliverables
  --b DIR               compare-runs: candidate B deliverables
  --label-a LABEL       compare-runs: metadata label for candidate A
  --label-b LABEL       compare-runs: metadata label for candidate B
  --no-metadata         Do not write run-metadata.json before execution
  -h, --help            Show this help

Set GDPVAL_API_KEY to override only the policy-model API key without putting
the secret on the command line. Judge configuration remains in env.yaml.
USAGE
}

export GDPVAL_COMMAND=run
if [[ "${1-}" == compare-runs ]]; then
  export GDPVAL_COMMAND=compare-runs
  shift
fi

require_value() {
  local option="$1"
  local value="${2-}"
  if [[ -z "$value" ]]; then
    echo "$option requires a value" >&2
    exit 2
  fi
}

while (( $# )); do
  case "$1" in
    --limit)
      require_value "$1" "${2-}"
      export LIMIT="$2"
      shift 2
      ;;
    --out)
      require_value "$1" "${2-}"
      export OUT="$2"
      shift 2
      ;;
    --parallel)
      require_value "$1" "${2-}"
      export PARALLEL="$2"
      shift 2
      ;;
    --provider)
      require_value "$1" "${2-}"
      export GDPVAL_PROVIDER="$2"
      shift 2
      ;;
    --model-type)
      require_value "$1" "${2-}"
      export GDPVAL_MODEL_TYPE="$2"
      shift 2
      ;;
    --model)
      require_value "$1" "${2-}"
      export GDPVAL_MODEL="$2"
      shift 2
      ;;
    --base-url)
      require_value "$1" "${2-}"
      export GDPVAL_BASE_URL="$2"
      shift 2
      ;;
    --judge-panel)
      require_value "$1" "${2-}"
      export GDPVAL_JUDGE_PANEL="$2"
      shift 2
      ;;
    --judge-model)
      require_value "$1" "${2-}"
      export GDPVAL_JUDGE_MODEL="$2"
      shift 2
      ;;
    --judge-base-url)
      require_value "$1" "${2-}"
      export GDPVAL_JUDGE_BASE_URL="$2"
      shift 2
      ;;
    --judge-seed)
      require_value "$1" "${2-}"
      export JUDGE_SAMPLING_SEED="$2"
      shift 2
      ;;
    --judge-only)
      export JUDGE_ONLY=true
      shift
      ;;
    --rubric)
      export GDPVAL_REWARD_MODE=rubric
      shift
      ;;
    --comparison)
      require_value "$1" "${2-}"
      export GDPVAL_REWARD_MODE=comparison
      export GDPVAL_REFS="$2"
      shift 2
      ;;
    --reference-manifest)
      require_value "$1" "${2-}"
      export GDPVAL_REFERENCE_MANIFEST="$2"
      shift 2
      ;;
    --aa-v2)
      require_value "$1" "${2-}"
      export GDPVAL_PROFILE=aa-v2
      export GDPVAL_REWARD_MODE=comparison
      export GDPVAL_REFS="$2"
      export GDPVAL_JUDGE_PANEL=aa-v2
      shift 2
      ;;
    --resume)
      export RESUME=1
      shift
      ;;
    --pin-gym)
      export PIN_GYM=1
      shift
      ;;
    --check)
      export GDPVAL_CHECK_ONLY=1
      shift
      ;;
    --a)
      require_value "$1" "${2-}"
      export GDPVAL_RUN_A="$2"
      shift 2
      ;;
    --b)
      require_value "$1" "${2-}"
      export GDPVAL_RUN_B="$2"
      shift 2
      ;;
    --label-a)
      require_value "$1" "${2-}"
      export GDPVAL_LABEL_A="$2"
      shift 2
      ;;
    --label-b)
      require_value "$1" "${2-}"
      export GDPVAL_LABEL_B="$2"
      shift 2
      ;;
    --no-metadata)
      export GDPVAL_WRITE_METADATA=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROVIDERS="$ROOT/scripts/gdpval_provider.sh"
PREFLIGHT="$ROOT/scripts/gdpval_preflight.sh"
METADATA="$ROOT/scripts/gdpval_run_metadata.py"
RECIPE="$ROOT/nemotron_recipes/lightning-3.5/instruct/gym/gdpval/gdpval.sh"
AA_V2_MANIFEST="$ROOT/config/gdpval-aa-v2-references.tsv"

if [[ ! -f "$PROVIDERS" ]]; then
  echo "GDPval provider helper not found: $PROVIDERS" >&2
  exit 1
fi
if [[ ! -x "$PREFLIGHT" ]]; then
  echo "GDPval preflight helper not found or not executable: $PREFLIGHT" >&2
  exit 1
fi
if [[ ! -f "$METADATA" ]]; then
  echo "GDPval metadata helper not found: $METADATA" >&2
  exit 1
fi
if [[ ! -f "$RECIPE" ]]; then
  echo "GDPval recipe not found: $RECIPE" >&2
  exit 1
fi

cd "$ROOT"
if [[ "${GDPVAL_COMMAND:-run}" == compare-runs ]]; then
  if [[ -z "${GDPVAL_RUN_A:-}" || -z "${GDPVAL_RUN_B:-}" ]]; then
    echo "compare-runs requires both --a and --b" >&2
    exit 2
  fi
  export JUDGE_ONLY=true
  export GDPVAL_REWARD_MODE=comparison
  export PERSIST_DELIVERABLES_DIR="$GDPVAL_RUN_A"
  export GDPVAL_SINGLE_REFERENCE_DIR="$GDPVAL_RUN_B"
  export GDPVAL_SINGLE_REFERENCE_ELO="${GDPVAL_SINGLE_REFERENCE_ELO:-1000}"
  export OUT="${OUT:-./results/compare-runs}"
  unset GDPVAL_PROFILE GDPVAL_REFS GDPVAL_REFERENCE_MANIFEST
fi
if [[ "${GDPVAL_PROFILE:-}" == aa-v2 && -z "${GDPVAL_REFERENCE_MANIFEST:-}" ]]; then
  export GDPVAL_REFERENCE_MANIFEST="$AA_V2_MANIFEST"
fi
# shellcheck source=scripts/gdpval_provider.sh
source "$PROVIDERS"
if [[ -n "${GDPVAL_PROVIDER:-}" ]]; then
  gdpval_apply_provider "$GDPVAL_PROVIDER"
fi
if [[ -n "${GDPVAL_JUDGE_API_KEY:-}" ]]; then
  export JUDGE_API_KEY="$GDPVAL_JUDGE_API_KEY"
fi
if [[ -n "${GDPVAL_JUDGE_BASE_URL:-}" ]]; then
  export JUDGE_BASE_URL="$GDPVAL_JUDGE_BASE_URL"
fi
if [[ -n "${GDPVAL_JUDGE_MODEL:-}" ]]; then
  export JUDGE_MODEL_NAME="$GDPVAL_JUDGE_MODEL"
fi
"$PREFLIGHT"

if [[ "${GDPVAL_CHECK_ONLY:-0}" != 0 ]]; then
  exit 0
fi

if [[ "${GDPVAL_WRITE_METADATA:-1}" != 0 ]]; then
  python3 "$METADATA"
fi

exec bash "$RECIPE"
